# =============================================================================
# Database Backup Agent - 环境变量配置示例
# =============================================================================
# 单用户模式配置
#
# 使用方法：
#   1. 复制此文件为 .env:  cp .env.example .env
#   2. 编辑 .env 文件，修改配置值
#   3. 启动服务: docker-compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 基础配置
# -----------------------------------------------------------------------------

# 时区设置（影响定时备份任务的执行时间）
# 可选值: Asia/Shanghai, Asia/Hong_Kong, Asia/Tokyo, America/New_York, Europe/London, UTC
TZ=Asia/Shanghai

# 日志级别
# 可选值: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 单用户模式配置
# -----------------------------------------------------------------------------

# 单用户模式开关
# true = 禁用多用户注册功能，仅允许一个管理员账号
# false = 启用多用户支持（默认）
SINGLE_USER_MODE=true

# 默认管理员账号（仅在首次启动时创建，如用户已存在则忽略）
# 留空则首次访问时需要手动注册
DEFAULT_USERNAME=admin

# 默认管理员密码
# 建议修改为强密码，或留空在首次访问时设置
# 注意：仅在首次启动且数据库为空时生效
DEFAULT_PASSWORD=

# -----------------------------------------------------------------------------
# 安全配置（生产环境必填）
# -----------------------------------------------------------------------------

# Flask 密钥（用于会话加密）
# ⚠️  生产环境请务必修改！可使用以下命令生成：
# python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-secret-key-change-this-in-production

# -----------------------------------------------------------------------------
# 备份配置
# -----------------------------------------------------------------------------

# 备份文件默认权限
BACKUP_FILE_MODE=0644
BACKUP_DIR_MODE=0755

# 备份存储路径（容器内路径，通常不需要修改）
# BACKUP_BASE_PATH=/backups

# -----------------------------------------------------------------------------
# 通知配置（可选）
# -----------------------------------------------------------------------------

# 邮件通知 SMTP 配置
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@example.com
# EMAIL_TO=admin@example.com

# 企业微信通知配置
# WECHAT_CORP_ID=your-corp-id
# WECHAT_CORP_SECRET=your-corp-secret
# WECHAT_AGENT_ID=your-agent-id
# WECHAT_TO_USERS=@all

# -----------------------------------------------------------------------------
# 高级配置（通常不需要修改）
# -----------------------------------------------------------------------------

# 数据库文件路径（SQLite）
# DB_PATH=/backups/users.db

# 会话超时时间（分钟）
# SESSION_TIMEOUT=480

# 最大备份并发数
# MAX_CONCURRENT_BACKUPS=1

# 备份锁超时时间（分钟）
# BACKUP_LOCK_TIMEOUT=120

# =============================================================================
# 使用示例
# =============================================================================
#
# 1. 基础单用户部署：
#    TZ=Asia/Shanghai
#    SINGLE_USER_MODE=true
#    DEFAULT_USERNAME=admin
#
# 2. 启用邮件通知：
#    SMTP_SERVER=smtp.qq.com
#    SMTP_PORT=587
#    SMTP_USERNAME=yourqq@qq.com
#    SMTP_PASSWORD=your-auth-code
#    EMAIL_TO=alert@example.com
#
# 3. 启用企业微信通知：
#    WECHAT_CORP_ID=wwxxxxxxxxxxxxxxxx
#    WECHAT_CORP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#    WECHAT_AGENT_ID=1000002
# =============================================================================
